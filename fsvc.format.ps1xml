<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>FSvc.TicketOverviewRow</Name>
      <ViewSelectedBy>
        <TypeName>FSvc.TicketOverviewRow</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Category</PropertyName></ListItem>
              <ListItem><PropertyName>Subject</PropertyName></ListItem>
              <ListItem><PropertyName>Elapsed</PropertyName></ListItem>
              <ListItem><Label>Unanswered</Label><ScriptBlock>if ($_.Unanswered) { $_.Unanswered } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Since</Label><ScriptBlock>if ($_.Since) { if ($_.Since.Offset -eq [timespan]::Zero) { $_.Since.ToString('yyyy-MM-ddTHH:mm:ss') + 'Z' } else { $_.Since.ToString('yyyy-MM-ddTHH:mm:sszzz') } } else { '-' }</ScriptBlock></ListItem>
              <ListItem><PropertyName>Link</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
