<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>FSvc.TicketOverviewRow</Name>
      <ViewSelectedBy>
        <TypeName>FSvc.TicketOverviewRow</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Category</PropertyName></ListItem>
              <ListItem><PropertyName>Subject</PropertyName></ListItem>
              <ListItem><PropertyName>Elapsed</PropertyName></ListItem>
              <ListItem><Label>FollowUps</Label><ScriptBlock>if ($_.FollowUps) { $_.FollowUps } else { '-' }</ScriptBlock></ListItem>
              <ListItem><Label>Since</Label><ScriptBlock>if ($_.Since) { $_.Since.ToString('yyyy-MM-dd HH:mm') } else { '' }</ScriptBlock></ListItem>
              <ListItem><PropertyName>Link</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
